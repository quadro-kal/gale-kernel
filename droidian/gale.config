# Droidian config fragment for gale (Redmi 13C / POCO C65)
# This file is included by kernel-snippet.mk as KERNEL_CONFIG_DEVICE_FRAGMENTS

# Disable schedtune - required for Droidian
CONFIG_SCHEDTUNE=n

# Droidian/Halium 13 kernel config additions
# Adds configs not already in gale_defconfig

# IPC & BinderFS (Halium 11/13 requires binderfs)
# Already in gale_defconfig:
# CONFIG_ANDROID_BINDER_IPC=y
# CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
# CONFIG_ANDROID_BINDERFS=y
# CONFIG_ASHMEM=y
# CONFIG_ANDROID_LOGGER=y

# Containerization (LXC / Systemd / Droidian)
# Already in gale_defconfig:
# CONFIG_NAMESPACES=y
# CONFIG_UTS_NS=y
# CONFIG_IPC_NS=y
# CONFIG_USER_NS=y
# CONFIG_PID_NS=y
# CONFIG_NET_NS=y
# CONFIG_CGROUPS=y
# CONFIG_CGROUP_FREEZER=y
# CONFIG_CGROUP_DEVICE=y
# CONFIG_CGROUP_CPUACCT=y
# CONFIG_CGROUP_SCHED=y
# CONFIG_CPUSETS=y
# CONFIG_MEMCG=y

# Networking for LXC/Waydroid
# Already in gale_defconfig:
# CONFIG_VETH=y
# CONFIG_MACVLAN=y
# CONFIG_BRIDGE=y
# CONFIG_NETFILTER_XT_MATCH_COMMENT=y

# File Systems (OverlayFS is critical for Droidian rootfs)
# Already in gale_defconfig:
# CONFIG_OVERLAY_FS=y
# CONFIG_TMPFS_POSIX_ACL=y
# CONFIG_TMPFS_XATTR=y
# CONFIG_SQUASHFS=y
# CONFIG_SQUASHFS_XZ=y

# Input & Display
# Already in gale_defconfig:
# CONFIG_INPUT_UINPUT=y
# CONFIG_INPUT_EVDEV=y
# CONFIG_FRAMEBUFFER_CONSOLE=y
# CONFIG_VT=y
# CONFIG_VT_CONSOLE=y

# Security (AppArmor for Droidian)
# Already in gale_defconfig:
# CONFIG_SECURITY_APPARMOR=y
# CONFIG_DEFAULT_SECURITY_APPARMOR=y
# CONFIG_SECURITY_APPARMOR_BOOTPARAM_VALUE=1

# Android 13 specific BPF requirements
# Already in gale_defconfig:
# CONFIG_BPF=y
# CONFIG_BPF_SYSCALL=y
# CONFIG_CGROUP_BPF=y
# CONFIG_BPF_JIT=y

# Panfrost GPU (for HWCOMPOSER-1 path via libhybris)
# Already in gale_defconfig:
# CONFIG_DRM_PANFROST=y
# (Full panfrost driver in drivers/gpu/drm/panfrost/)
# DISABLED: Droidian/Halium uses Android Mali blobs via libhybris which need
# the kbase kernel driver, not Panfrost/Mesa. Avoids GPU bind conflicts.
CONFIG_DRM_PANFROST=n

# Additional configs that may be needed for Droidian:
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Debug configs - DISABLED for bring-up speed and smaller Image.
# Re-enable (DEBUG_INFO=y) only if an early boot crash needs symbols.
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_DWARF5 is not set
CONFIG_DEBUG_INFO_COMPRESSED=n

# Ensure module signing is disabled (we're not signing modules)
CONFIG_MODULE_SIG=n
CONFIG_MODULE_SIG_ALL=n

# F2FS (used by Android)
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_FS_ENCRYPTION=y

# ZRAM (for memory compression)
CONFIG_ZRAM=y
CONFIG_ZRAM_WRITEBACK=y

# Reverted to y - will use period-correct GCC 4.9 instead of disabling
# NOTE: both IOMMU drivers in drivers/iommu/ are OFF for mt6768/gale:
# gen1 (mtk_iommu.c) is for older SoCs and version-mixed here;
# V2 (mtk_iommu_v2.c) needs register macros absent from mt6768 headers.
# mt6768 IOMMU is served by drivers/misc/mediatek/m4u/2.0 (M4U version 2.0).
# CONFIG_MTK_IOMMU_V2 is not set
# gen1 M4U (mtk_iommu.c) is for older SoCs and version-mixed here;
# mt6768/gale uses V2 only
CONFIG_MTK_IOMMU=n

# Omnivision TCM touchscreen - uses deprecated send_sig_info
CONFIG_TOUCHSCREEN_OMNIVISION_TCM_SPI=y

# DVFSRC collision: stock defconfig enables BOTH drivers/misc/mediatek/dvfsrc
# (CONFIG_MTK_DVFSRC) AND drivers/devfreq/helio-dvfsrc-v2 (via CONFIG_MACH_MT6768),
# which define the same symbols (dvfsrc_set_power_model_ddr_request,
# dvfsrc_enable_dvfs_freq_hopping, vcorefs_get_*, met_src_name) -> vmlinux link
# fails with "multiple definition". For mt6768 the helio v2 driver is the right
# one (has mt6768 opp tables; misc/dvfsrc only ships opp for mt6761/mt6765).
# Nothing built for mt6768 references misc/dvfsrc-unique symbols
# (mmdvfs use is commented out; cm_mgr has no mt6768 file).
CONFIG_MTK_DVFSRC=n
