#!/usr/bin/make -f

include /usr/share/linux-packaging-snippets/kernel-snippet.mk

# Debug target to print variables at rule execution time
debug-vars:
	@echo "KERNEL_BASE_VERSION=$(KERNEL_BASE_VERSION)"
	@echo "DEVICE_VENDOR=$(DEVICE_VENDOR)"
	@echo "DEVICE_MODEL=$(DEVICE_MODEL)"
	@echo "DEVICE_FULL_NAME=$(DEVICE_FULL_NAME)"
	@echo "VARIANT=$(VARIANT)"
	@echo "CLANG_CUSTOM=$(CLANG_CUSTOM)"
	@echo "DEB_TOOLCHAIN=$(DEB_TOOLCHAIN)"
	@echo "BUILD_PATH=$(BUILD_PATH)"
	@echo "BUILD_CC=$(BUILD_CC)"
	@echo "KERNEL_RELEASE=$(KERNEL_RELEASE)"

# Override build to pass LD=ld.lld for VDSO cross-linking
override_dh_auto_build:
	PATH=$(FULL_PATH) LDFLAGS="" CFLAGS="" HOSTLDFLAGS=$(HOSTLDFLAG) $(MAKE) -C $(KERNEL_SOURCES) \
		KERNELRELEASE=$(KERNEL_RELEASE) ARCH=$(KERNEL_ARCH) \
		CROSS_COMPILE=$(CROSS_COMPILE) CROSS_COMPILE_ARM32=$(CROSS_COMPILE) \
		CLANG_TRIPLE=$(BUILD_CLANG_TRIPLET) \
		LD=ld.lld \
		-j$(NUMJOBS) $(MAKEOPTS) O=$(KERNEL_OUT) CC=$(BUILD_CC)

%:
	dh $@